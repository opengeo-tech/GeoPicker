FROM node:18-buster-slim

WORKDIR /home

# Copy only the dependency manifests before the rest of the code: as long as
# these don't change, Docker reuses the cache and skips npm install even when
# other files change (routes, config, index.html, cli commands, etc).
COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY cli/package.json ./cli/
RUN npm install

# Make workspace bins (geopicker-cli's `geopicker` command, symlinked by npm
# into node_modules/.bin) runnable by name from anywhere in the container.
ENV PATH="/home/node_modules/.bin:${PATH}"

# Source code is copied last: its changes only invalidate this layer, not
# the npm install step above.
COPY ./ ./

# npm only symlinks a workspace's `bin` entry into node_modules/.bin if the
# target file already exists at install time. It didn't during the first
# `npm install` above (only manifests were present), so re-run it now that
# cli/bin/geopicker-cli exists; --ignore-scripts avoids re-triggering native
# builds (gdal-async), making this a fast local relink with no registry access.
RUN npm install --ignore-scripts

# Install the bash completion script generated by the CLI itself, and source it
# for interactive shells (docker exec -it <container> bash); the slim image has
# no bash-completion package, so /etc/bash_completion.d is not sourced by default.
RUN mkdir -p /etc/bash_completion.d \
 && geopicker completion > /etc/bash_completion.d/geopicker \
 && echo '. /etc/bash_completion.d/geopicker' >> /etc/bash.bashrc

CMD ["geopicker", "server-start"]
