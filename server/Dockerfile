FROM node:20-bookworm-slim

WORKDIR /home

# Manifests first: while they don't change Docker reuses the cached npm install.
COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY cli/package.json ./cli/
RUN npm install

# Run the workspace bins (the `geopicker` command) by name from any directory.
ENV PATH="/home/node_modules/.bin:${PATH}"

# Source code last: changing it doesn't invalidate the npm install layer above.
COPY ./ ./

# npm links a workspace bin only if it exists at install time, cli/bin/geopicker
# didn't above: relink it, --ignore-scripts skips the gdal-async native build.
RUN npm install --ignore-scripts

# Bash completion generated by the CLI, sourced for interactive shells since the
# slim image doesn't read /etc/bash_completion.d.
RUN mkdir -p /etc/bash_completion.d \
 && geopicker bash-completion > /etc/bash_completion.d/geopicker \
 && echo '. /etc/bash_completion.d/geopicker' >> /etc/bash.bashrc

CMD ["geopicker", "server-start", "--config", "server/config.yml"]
